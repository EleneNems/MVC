<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] - my Dream Place</title>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <nav class="topnav">
    <div class="brand"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"/></svg> my Dream Place</div>
    <div class="menu"><span>Home</span><span>Discover</span><span>Activities</span><span>About</span><span>Contact</span></div>
    <form asp-controller="Account" asp-action="Logout" method="post"><button class="link" type="submit">Sign out</button></form>
    <div class="avatar" title="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value?[0].ToString().ToUpper()</div>
  </nav>
  <div class="page"><div class="wrap">@RenderBody()</div></div>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
