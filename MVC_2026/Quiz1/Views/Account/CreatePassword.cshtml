@model CreatePasswordViewModel
@{ ViewData["Title"] = "Create password"; }
<h1>Create password</h1>
<p class="sub">Use a minimum of 10 characters, including letters, lowercase letters, and numbers.</p>
<form asp-action="CreatePassword" method="post" novalidate>
  <label asp-for="Password"></label>
  <div class="fld">
    <input asp-for="Password" autocomplete="new-password" />
    <button type="button" class="eye" data-eye="Password" aria-label="Show or hide password">👁</button>
  </div>
  <span asp-validation-for="Password" class="err"></span>

  <label asp-for="ConfirmPassword"></label>
  <div class="fld">
    <input asp-for="ConfirmPassword" autocomplete="new-password" />
    <button type="button" class="eye" data-eye="ConfirmPassword" aria-label="Show or hide password">👁</button>
  </div>
  <span asp-validation-for="ConfirmPassword" class="err"></span>

  <button class="btn" type="submit">Create account</button>
</form>
<p class="note">By creating an account, you agree with our <a href="#" class="link">Terms and Conditions</a> and <a href="#" class="link">Privacy Statement</a>.</p>
