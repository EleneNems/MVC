@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot password"; }
<h1>Forgot your password?</h1>
<p class="sub">We’ll send you a link to reset it. Enter your email address used for My Dream Place</p>
@if (ViewBag.Sent == true)
{
  <div class="banner ok">If an account exists for @Model.Email, a reset link has been sent.</div>
  @if (ViewBag.TempPassword is string temp)
  {
    <div class="demo" style="border:0">Demo only (no email is sent): your temporary password is <code>@temp</code>.
    You will be asked to change it on your next sign-in.</div>
  }
}
else
{
  <form asp-action="ForgotPassword" method="post" novalidate>
    <label asp-for="Email"></label>
    <input asp-for="Email" autocomplete="email" />
    <span asp-validation-for="Email" class="err"></span>
    <button class="btn" type="submit">Send Reset Link</button>
  </form>
}
<div class="right"><a asp-action="Login" class="link">Back to sign in</a></div>
